<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!--
			Hard-fail if a csproj declares <PackageReference Version="…" />
			alongside CPM. Catches drift if someone adds a per-project pin
			by accident — without this, MSBuild silently ignores the inline
			version and uses the CPM one, which is the bug we're trying to
			make impossible.
		-->
		<CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
	</PropertyGroup>

	<!--
		Runtime-aligned Microsoft platform deps: per-TFM floors.

		A PackageReference version in a library is a *minimum* that NuGet
		forces on every downstream consumer (lowest-applicable-version
		resolution). Flooring these runtime-aligned packages at a single
		high major (10.0.x) would drag net8 LTS consumers off their own
		runtime-aligned servicing line onto the net10 one. So each target
		framework floors at the latest servicing version of its *own* major:
		net8 → 8.0.x, net10 → 10.0.x. CPM re-evaluates these conditional
		groups per-TFM during the inner build, so each provider assembly
		picks up the floor matching the framework it is compiled for. These
		match the per-TFM floors the core NextIteration.SpectreConsole.Auth
		package declares (see the capped range below).
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
	</ItemGroup>

	<!--
		Runtime dependencies that are NOT runtime-aligned: a single common
		floor at the version actually built and tested against. Spectre.Console
		is pre-1.0 (breaking changes land between minors, so a low floor would
		be both meaningless and risky); the core library is a capped range.
	-->
	<ItemGroup>
		<PackageVersion Include="Spectre.Console" Version="0.57.2" />
		<!--
			Capped range: accept any patch/minor in the 2.x line, but
			prevent a silent upgrade to 3.0.0 where the ICredentialCollector /
			ICredentialSummaryProvider / ICredentialManager contracts could
			break. Bump the upper bound deliberately after validating against
			the next major.
			Floored at 2.1.0: the version built and tested against. The floor
			tracks the tested-against version per STANDARD.md 1.4, so it moved
			with the core 2.1.0 adoption. Core 2.1.0 raised its own net10
			dependency floors (Microsoft.Extensions.DependencyInjection.Abstractions
			and Microsoft.Extensions.Http to 10.0.12); the net10 ItemGroup above
			matches them, so the graph resolves downgrade-free. Its net8 floors
			(8.0.2 / 8.0.1) were unchanged from 2.0.0, so net8 needs no bump.
			The 2.x floor itself exists because core 2.0.0 added a trailing
			CancellationToken to ICredentialCollector.CollectAsync, to the
			three IAuthenticationService<,> members and across the
			ICredentialManager surface — the change the previous [1.0.1,2.0.0)
			cap refused, and refused correctly. Because the providers *implement*
			those interfaces, a 1.x provider assembly running against core
			2.x would fail at runtime; the range turns that into a restore
			error instead. Consumers on core 1.x cannot use these providers.
		-->
		<PackageVersion Include="NextIteration.SpectreConsole.Auth" Version="[2.1.0,3.0.0)" />
	</ItemGroup>

	<!-- Build / source-link tooling (PrivateAssets in csprojs). STANDARD.md 1.7. -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
	</ItemGroup>

	<!--
		Test-only. STANDARD.md 2.1/2.5/2.6 — xunit.v3 on Microsoft.Testing.Platform.
		Do NOT add Microsoft.NET.Test.Sdk, xunit.runner.visualstudio or
		coverlet.collector: all three are VSTest-only and MTP replaces the runner.
	-->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageVersion Include="xunit.v3" Version="4.0.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
	</ItemGroup>

</Project>
